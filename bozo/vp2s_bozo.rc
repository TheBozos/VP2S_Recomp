// vp2s-bozo's resources on Windows: its icon (VP2S's variant of The Bozos' logo, the clown in a winged helmet; no game
// art), as resource 1 (Explorer and the window class take the first icon), and its version information.
#include <winver.h>

1 ICON "../port/app/vp2s.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Valkyrie Profile 2: Silmeria"
            VALUE "ProductName", "Valkyrie Profile 2: Silmeria (VP2S_Recomp, a native PC port)"
            VALUE "InternalName", "vp2s-bozo"
            VALUE "OriginalFilename", "vp2s-bozo.exe"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
