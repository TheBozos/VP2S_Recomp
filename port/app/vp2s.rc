// The runner's resources on Windows: its icon (VP2S's variant of The Bozos' logo, the clown in a winged helmet; no game
// art; GLFW_ICON is the name GLFW gives the window's class, so the window and the taskbar show it too) and its version
// information.
#include <winver.h>

GLFW_ICON ICON "vp2s.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Valkyrie Profile 2: Silmeria"
            VALUE "ProductName", "Valkyrie Profile 2: Silmeria (VP2S_Recomp, a native PC port)"
            VALUE "InternalName", "vp2s"
            VALUE "OriginalFilename", "vp2s.exe"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
